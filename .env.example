# Application & Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Security & Webhook Signatures
WEBHOOK_HMAC_SECRET="your_64_char_hex_webhook_signing_secret"
WEBHOOK_INGRESS_SECRET="your_64_char_hex_webhook_signing_secret"
HITL_OPERATOR_SECRET="your_operator_signature_secret_here"

# Supabase (eu-north-1 / PostgreSQL)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key_here"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_secret_service_role_key_here"
SUPABASE_DB_POOLER_URL="postgresql://postgres.your-project-ref:[PASSWORD]@aws-0-eu-north-1.pooler.supabase.com:6543/postgres"
SUPABASE_DIRECT_POSTGRES_URL="postgresql://postgres.your-project-ref:[PASSWORD]@aws-0-eu-north-1.pooler.supabase.com:6543/postgres"

# Upstash Redis (BullMQ & Circuit Breakers)
UPSTASH_REDIS_URL="rediss://default:your_redis_password@your-redis-host.upstash.io:6379"
REDIS_URL="rediss://default:your_redis_password@your-redis-host.upstash.io:6379"

# Vercel AI Gateway (Universal Model Provider)
AI_GATEWAY_API_KEY="your_ai_gateway_api_key"

# Google Gemini API (@google/genai)
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.5-flash-lite"

# GitHub Integration (Zero-Disk Git Synthesis)
GITHUB_ACCESS_TOKEN="ghp_your_github_personal_access_token"
GITHUB_REPO_OWNER="dewald23"
GITHUB_REPO_NAME="Touch-Base-Engine"

# Resend (Transactional HITL Alerts)
RESEND_API_KEY="re_your_resend_api_key_here"
RESEND_FROM_EMAIL="dispatch@touchbaseconsulting.co.za"
HITL_ALERT_EMAIL="ops@touchbaseconsulting.co.za"

# Vercel Deployment
VERCEL_API_TOKEN="your_vercel_api_token_here"
